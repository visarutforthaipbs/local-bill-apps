{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billngai-sync-coordinator-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "node-fetch": "./src/apple-fetch.cjs"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "ALLOWED_SUBJECTS": "",
    "LOG_REJECTED_SUBJECT": "",
    "LICENSE_PUBLIC_KEY": "",
    "MAX_ACCOUNTS_PER_LICENSE": "3",
    "APPSTORE_BUNDLE_ID": "com.visarut.billngai",
    "APPSTORE_PRODUCT_ID": "com.visarut.billngai.pro",
    "APPSTORE_SANDBOX_SUBJECTS": "",
    "APPSTORE_APP_ID": "6789503350",
    "GOOGLE_CLIENTS": "",
    "REVOKED_PURCHASES": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "Workspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Workspace"
      ]
    }
  ],
  "secrets": {
    "required": [
      "APPSTORE_SIGNING_KEY",
      "APPSTORE_KEY_ID",
      "APPSTORE_ISSUER_ID"
    ]
  },
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.cer"
      ],
      "fallthrough": true
    }
  ]
}
